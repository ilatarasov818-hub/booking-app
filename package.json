{
  "name": "booking-app",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p . && vite build",
    "start": "npm run build && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "lint": "oxlint src server",
    "check": "npm run lint && npm test && npm run build"
  },
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  },
  "private": true,
  "type": "module"
}
